# À saisir dans Vercel > Settings > Environment Variables (jamais dans le code, jamais dans Git)
ADMIN_USER=
ADMIN_PASSWORD=
SESSION_SECRET=            # 32+ caractères aléatoires: openssl rand -hex 32
SUPABASE_URL=              # même URL que dans assets/config.js
SUPABASE_SERVICE_ROLE_KEY= # Supabase > Settings > API > service_role (SECRÈTE)
ADMIN_EMAIL=               # email du compte inscrit puis ajouté à la table admins
